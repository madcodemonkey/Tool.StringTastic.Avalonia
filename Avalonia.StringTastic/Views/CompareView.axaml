<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Avalonia.StringTastic.Views.CompareView"
             xmlns:vm="using:Avalonia.StringTastic.ViewModels"
             x:DataType="vm:CompareViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top button bar: left buttons left-aligned, right buttons right-aligned -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="5">
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding ClearLeftCommand}" ToolTip.Tip="Clear left text">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding SortLeftCommand}" ToolTip.Tip="Sort left text">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Sort" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding UniqueLeftCommand}" ToolTip.Tip="Remove duplicates from left">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Unique" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding TrimLeftCommand}" ToolTip.Tip="Trim whitespace from left">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M7,14H9V16H7V14M12,14H14V16H12V14M15,14H17V16H15V14M7,11H9V13H7V11M12,11H14V13H12V11M15,11H17V13H15V11M7,8H9V10H7V8M12,8H14V10H12V8M15,8H17V10H15V8Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Trim" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="5">
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding ClearRightCommand}" ToolTip.Tip="Clear right text">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding SortRightCommand}" ToolTip.Tip="Sort right text">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Sort" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding UniqueRightCommand}" ToolTip.Tip="Remove duplicates from right">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Unique" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding TrimRightCommand}" ToolTip.Tip="Trim whitespace from right">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M7,14H9V16H7V14M12,14H14V16H12V14M15,14H17V16H15V14M7,11H9V13H7V11M12,11H14V13H12V11M15,11H17V13H15V11M7,8H9V10H7V8M12,8H14V10H12V8M15,8H17V10H15V8Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Trim" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Splitter area with text boxes -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="80" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="80" />
            </Grid.ColumnDefinitions>

            <!-- Left text area -->
            <TextBox Grid.Column="0"
                     x:Name="LeftTextBox"
                     Text="{Binding LeftText, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Margin="0,0,5,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     CaretBrush="{DynamicResource TextBoxCaretBrush}" />

            <!-- Splitter with center buttons overlaid -->
            <GridSplitter Grid.Column="1" Width="90" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent" />
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding UniqueLeftToRightCommand}" ToolTip.Tip="Unique items from left go to right">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Unique L&#x2192;R" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding UniqueRightToLeftCommand}" ToolTip.Tip="Unique items from right go to left">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Unique R&#x2192;L" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding ShowDifferencesCommand}" ToolTip.Tip="Show differences between left and right">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H13V5H19M11,5V11H5V5H11M5,13H11V19H5V13Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Differences" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolbarRaisedButton"
                        Command="{Binding ShowSimilaritiesCommand}" ToolTip.Tip="Show similarities between left and right">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H13V5H19M11,5V11H5V5H11M5,13H11V19H5V13Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Similarities" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right text area -->
            <TextBox Grid.Column="2"
                     x:Name="RightTextBox"
                     Text="{Binding RightText, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Margin="5,0,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     CaretBrush="{DynamicResource TextBoxCaretBrush}" />
        </Grid>
    </Grid>
</UserControl>