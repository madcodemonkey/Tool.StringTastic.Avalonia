<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avalonia.StringTastic.ViewModels"
             x:Class="Avalonia.StringTastic.Views.JsonFormatterView"
             x:DataType="vm:JsonFormatterViewModel">

    <UserControl.Styles>
        <Style Selector="Button.ToolbarRaisedButton">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Classes="ToolbarRaisedButton"
                    Command="{Binding FormatCommand}" ToolTip.Tip="Format JSON with proper indentation">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6M14.6,7.4L19.2,12L14.6,16.6L16,18L22,12L16,6L14.6,7.4Z" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Format" />
                </StackPanel>
            </Button>
            <Button Classes="ToolbarRaisedButton"
                    Command="{Binding SortPropertiesCommand}" ToolTip.Tip="Format and sort all properties alphabetically">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Sort &amp; Format" />
                </StackPanel>
            </Button>
            <Button Classes="ToolbarRaisedButton"
                    Command="{Binding CopyCommand}" ToolTip.Tip="Copy contents to clipboard">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Copy" />
                </StackPanel>
            </Button>
            <Button Classes="ToolbarRaisedButton"
                    Command="{Binding ClearCommand}" ToolTip.Tip="Clear all text">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Single TextBox for input and output -->
        <TextBox Grid.Row="1"
                 x:Name="InputTextBox"
                 Text="{Binding InputText, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Margin="5"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 CaretBrush="{DynamicResource TextBoxCaretBrush}" />
    </Grid>
</UserControl>