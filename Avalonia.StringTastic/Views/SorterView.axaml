<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avalonia.StringTastic.ViewModels"
             x:Class="Avalonia.StringTastic.Views.SorterView"
             x:DataType="vm:SorterViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Classes="ToolbarRaisedButton"
                    Command="{Binding ClearCommand}"
                    ToolTip.Tip="Clear all text">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
            <Button Classes="ToolbarRaisedButton"
                    Command="{Binding SortAscendingCommand}"
                    ToolTip.Tip="Sort lines in ascending order">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Sort Ascending" />
                </StackPanel>
            </Button>
            <Button Classes="ToolbarRaisedButton"
                    Command="{Binding SortDescendingCommand}"
                    ToolTip.Tip="Sort lines in descending order">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="M16,3L20,7H17V14H15V7H12M9,17V10H11V17H14L10,21L6,17H9Z" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Sort Descending" />
                </StackPanel>
            </Button>
            <Button Classes="ToolbarRaisedButton"
                    Command="{Binding UniqueCommand}"
                    ToolTip.Tip="Remove duplicate lines">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Unique" />
                </StackPanel>
            </Button>
            <Button Classes="ToolbarRaisedButton"
                    Command="{Binding TrimCommand}"
                    ToolTip.Tip="Trim whitespace from each line">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="M7,14H9V16H7V14M12,14H14V16H12V14M15,14H17V16H15V14M7,11H9V13H7V11M12,11H14V13H12V11M15,11H17V13H15V11M7,8H9V10H7V8M12,8H14V10H12V8M15,8H17V10H15V8Z" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Trim" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- TextBox -->
        <TextBox Grid.Row="1"
                 x:Name="InputTextBox"
                 Text="{Binding InputText, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Margin="5"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 CaretBrush="{DynamicResource TextBoxCaretBrush}" />
    </Grid>
</UserControl>