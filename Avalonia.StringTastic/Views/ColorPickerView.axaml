<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avalonia.StringTastic.ViewModels"
             x:Class="Avalonia.StringTastic.Views.ColorPickerView"
             x:DataType="vm:ColorPickerViewModel">

    <ScrollViewer>
        <StackPanel Margin="10" Spacing="10">

            <!-- Hex input row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Hex Color:"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource WindowForegroundBrush}" />

                <TextBox Grid.Column="1"
                         x:Name="HexColorTextBox"
                         Text="{Binding HexColorText, Mode=TwoWay}"
                         Padding="5"
                         Foreground="{DynamicResource TextBoxForegroundBrush}"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         CaretBrush="{DynamicResource TextBoxCaretBrush}" />

                <Button Grid.Column="2"
                        Classes="ToolbarRaisedButton"
                        Margin="5,0,0,0"
                        ToolTip.Tip="Apply hex color to preview"
                        Command="{Binding ApplyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Apply" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Classes="ToolbarRaisedButton"
                        Margin="5,0,0,0"
                        ToolTip.Tip="Clear color"
                        Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Classes="ToolbarRaisedButton"
                        Margin="5,0,0,0"
                        ToolTip.Tip="Copy hex color to clipboard"
                        Command="{Binding CopyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Clickable color preview — click to open picker dialog -->
            <Button HorizontalAlignment="Stretch"
                    MinHeight="80"
                    Command="{Binding PickColorCommand}"
                    Background="{Binding SelectedColorBrush}"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                Click to pick a color
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>